# Cle d'API Mistral, obligatoire pour /ask et make eval. Ne jamais la commiter.
MISTRAL_API_KEY=
# Modele Mistral de chat ; codestral-latest est le choix de l'evaluation (make eval).
MISTRAL_MODEL=codestral-latest
# Chemin du warehouse DuckDB, ouvert en lecture seule par l'API.
ANAMNESE_DUCKDB_PATH=data/warehouse/anamnese.duckdb
# Dossier des artefacts dbt (manifest.json, catalog.json) : contexte envoye au LLM.
ANAMNESE_DBT_TARGET_PATH=transform/target
# Nombre maximal de lignes renvoyees par une requete (enveloppe LIMIT).
ANAMNESE_MAX_ROWS=1000
# Duree maximale d'execution d'une requete, en secondes, avant interruption.
ANAMNESE_QUERY_TIMEOUT_SECONDS=10
# Niveau de journalisation : DEBUG, INFO, WARNING ou ERROR.
ANAMNESE_LOG_LEVEL=INFO
# Fichier DuckDB ecrit par dbt, relatif a transform/. Doit finir par anamnese.duckdb.
ANAMNESE_DBT_DUCKDB_PATH=../data/warehouse/anamnese.duckdb
